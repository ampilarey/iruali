APP_NAME=Iruali
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite (database/database.sqlite).
# For production (cPanel), switch to MySQL and set APP_ENV=production,
# APP_DEBUG=false, LOG_LEVEL=error and a real APP_URL / SMTP mail config.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=iruali
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=iruali_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Off-server backups: the "s3" disk works with AWS S3, Backblaze B2 and MinIO.
# B2:    AWS_ENDPOINT=https://s3.<region>.backblazeb2.com  AWS_DEFAULT_REGION=<region>  (path style false)
# MinIO: AWS_ENDPOINT=https://minio.example.com  AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Where nightly backups go (comma list of disks from config/filesystems.php). "local,s3" keeps one
# copy on the server and one off-site. The first disk is used for the monthly restore drill.
BACKUP_DISKS=local
# Scratch database the monthly restore drill (backup:restore-drill) restores into and drops again.
# Must NOT be the live database; it is created if the DB user may create databases.
DB_DRILL_DATABASE=iruali_drill

VITE_APP_NAME="${APP_NAME}"

# BML Connect (Bank of Maldives card payments). Leave BML_API_KEY empty to hide card payment.
# Use sandbox (UAT) until BML approves the go-live, then set BML_ENVIRONMENT=production and the live key.
BML_API_KEY=
BML_ENVIRONMENT=sandbox
# Optional (see docs/PAYMENTS_BML.md)
BML_APP_ID=
BML_AUTH_MODE=auto
BML_WEBHOOK_SECRET=
BML_EXTERNAL_TERMS_URL=

# Staff (admin, support, finance) must have two-step sign-in on to open /admin. Off for local
# development only; remove the line (default true) on the live site.
STAFF_REQUIRE_2FA=false

# --- Production reference (see docs/PRODUCTION_DEPLOY.md) ---
# APP_ENV=production, APP_DEBUG=false, APP_URL=https://iruali.mv
APP_TIMEZONE=Indian/Maldives
# Emails are queued (every notification is ShouldQueue). The scheduler cron starts a short
# queue worker every minute (routes/console.php), so nothing else needs to run. Never "sync" on production.
# QUEUE_CONNECTION=database
# Where payment error alerts, the 07:00 error digest, backup failures and the restore drill
# report go. Empty = the contact email from Admin → Settings.
# ALERTS_EMAIL=you@iruali.mv
# Optional: composer require sentry/sentry-laravel, then Sentry takes over alerting.
# SENTRY_LARAVEL_DSN=
# SESSION_SECURE_COOKIE=true
# LOG_STACK=daily  LOG_LEVEL=warning  LOG_DAILY_DAYS=14
# First admin on production (used by: php artisan db:seed --class=UserSeeder)
# ADMIN_EMAIL=you@iruali.mv
# ADMIN_PASSWORD=
# API tokens expire after this many minutes (default 30 days)
# SANCTUM_EXPIRATION=43200

# Post-deploy smoke test customer (php artisan iruali:smoke --setup, then --place-order)
SMOKE_USER_EMAIL=
SMOKE_USER_PASSWORD=
