# Static analysis with Larastan (PHPStan for Laravel).
#
# Larastan is not in composer.lock (it could not be fetched in the sandbox where this repo is
# worked on), so install it locally first, then run `composer analyse`:
#
#   composer require --dev larastan/larastan
#   composer analyse
#
# CI runs the same at level 5 as a non-blocking job (see .github/workflows/tests.yml, job
# "static-analysis"); findings are advisory until the package is committed to composer.json
# and the job is made blocking.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
    tmpDir: storage/framework/cache/phpstan
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Spatie translatable fields are arrays on write and strings on read; the models' docblocks say string
        - '#Cannot access offset .* on array\|string#'
