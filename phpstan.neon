# Static analysis with Larastan (PHPStan for Laravel), level 5, over app/.
#
#   composer analyse
#
# Larastan is a locked dev dependency, and CI runs the same check (job "static-analysis" in
# .github/workflows/tests.yml) and fails on any finding, so fix what it reports rather than
# ignoring it. Two conventions keep it accurate:
#   - every Eloquent relation declares its model: /** @return BelongsTo<Product, $this> */
#   - values that are not real columns (counts, totals from a grouped query) are set with
#     setAttribute() and read with getAttribute(), or the query uses ->toBase() for plain rows.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
    tmpDir: storage/framework/cache/phpstan
    treatPhpDocTypesAsCertain: false
